#!/usr/bin/env bash

set -u

echo
echo "DUCS PREFLIGHT v0.2"
echo "=================="
echo

PASS=0
BLOCKED=0

check_present() {
    local name="$1"
    local path="$2"

    if [ -e "$path" ]; then
        printf "PASS     %-30s PRESENT\n" "$name"
        PASS=$((PASS + 1))
    else
        printf "BLOCKED  %-30s MISSING\n" "$name"
        BLOCKED=$((BLOCKED + 1))
    fi
}

check_admitted() {
    local name="$1"
    local path="$2"

    if [ ! -f "$path" ]; then
        printf "BLOCKED  %-30s NOT ADMITTED\n" "$name"
        BLOCKED=$((BLOCKED + 1))
        return
    fi

    if ! command -v python3 >/dev/null 2>&1; then
        printf "BLOCKED  %-30s PYTHON3 REQUIRED\n" "$name"
        BLOCKED=$((BLOCKED + 1))
        return
    fi

    local admission
    admission="$(
        python3 - "$path" <<'PY'
import json
import sys

path = sys.argv[1]

try:
    with open(path, "r", encoding="utf-8") as f:
        obj = json.load(f)

    value = obj.get("admission")

    if isinstance(value, str):
        print(value)
    else:
        print("MISSING")
except Exception:
    print("INVALID")
PY
    )"

    case "$admission" in
        ADMITTED)
            printf "PASS     %-30s ADMITTED\n" "$name"
            PASS=$((PASS + 1))
            ;;
        INCOMPLETE)
            printf "BLOCKED  %-30s INCOMPLETE\n" "$name"
            BLOCKED=$((BLOCKED + 1))
            ;;
        BLOCKED)
            printf "BLOCKED  %-30s BLOCKED\n" "$name"
            BLOCKED=$((BLOCKED + 1))
            ;;
        MISSING)
            printf "BLOCKED  %-30s ADMISSION UNDECLARED\n" "$name"
            BLOCKED=$((BLOCKED + 1))
            ;;
        INVALID)
            printf "BLOCKED  %-30s INVALID JSON\n" "$name"
            BLOCKED=$((BLOCKED + 1))
            ;;
        *)
            printf "BLOCKED  %-30s ADMISSION=%s\n" "$name" "$admission"
            BLOCKED=$((BLOCKED + 1))
            ;;
    esac
}

check_present "RECON-001" "RECON-001"
check_present "DUCS-REF-001" "DUCS-REF-001"

echo
echo "RUNTIME INPUT ADMISSION"
echo "-----------------------"

check_admitted "DCP-001" "runtime_input/DCP-001.json"
check_admitted "EVD-001" "runtime_input/EVD-001.json"
check_admitted "EVD-002" "runtime_input/EVD-002.json"
check_admitted "EVD-003" "runtime_input/EVD-003.json"
check_admitted "ONR-FGRAI-SPATIAL-001" "runtime_input/ONR-FGRAI-SPATIAL-001.json"

echo
echo "EXECUTION GATE"
echo "--------------"

if [ "$BLOCKED" -eq 0 ]; then
    echo "GOLD-001: AUTHORIZED"
    echo
    echo "All required runtime inputs are explicitly ADMITTED."
else
    echo "GOLD-001: BLOCKED"
    echo
    echo "Reason:"
    echo "One or more required runtime inputs are not explicitly ADMITTED."
    echo
    echo "No execution artifacts generated."
    echo "No evidence manufactured."
fi

echo
echo "RESULT"
echo "------"
echo "PASS checks:    $PASS"
echo "Blocked checks: $BLOCKED"

if [ "$BLOCKED" -gt 0 ]; then
    echo "STATUS: HOLD"
    exit 2
fi

echo "STATUS: READY"
exit 0
